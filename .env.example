# Trimir — environment variables
# Phase 1 is frontend-only with mock data (Local Storage), so no variables are required yet.
# These are placeholders for Phase 2 (Django backend integration).

# Base URL of the backend API (Phase 2)
VITE_API_BASE_URL=http://localhost:8000/api

# Payment gateway sandbox (Phase 2) — see docs/BACKEND_REQUIREMENTS.md
VITE_PAYMENT_SANDBOX=true
